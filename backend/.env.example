# Shared secret the web app sends in X-Classifier-Key (required unless ALLOW_UNAUTHENTICATED=1 for local dev)
CLASSIFIER_API_KEY=
ALLOW_UNAUTHENTICATED=
# Existing Google Gemini credential (primary when configured; never commit its value)
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3-flash-preview
# Folder with best.pt + config.json from train.py
ML_MODEL_DIR=
# Comma-separated browser origins (not needed for server-to-server calls)
CORS_ORIGINS=
